# Kalaa Setu frontend — environment variables
# Only API_BASE_URL (BRAIN.md Section H) is relevant to this module.
# The frontend never calls the AI or matching services directly, and never
# reads AI_SERVICE_URL / MATCHING_SERVICE_URL / OPENSEARCH_URL / etc.

# Base URL of the backend API (Dipanshu's module). Vite requires the
# VITE_ prefix to expose a variable to client-side code .
VITE_API_BASE_URL=http://localhost:3000

# Set to "true" to force the in-memory MockApiClient even if a backend is
# reachable (useful for isolated frontend development/demo). Defaults to
# "false" — the app tries the real backend first. See src/config.js.
VITE_USE_MOCK_API=false
