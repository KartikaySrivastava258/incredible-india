# Kalaa Setu — backend environment template (matches BRAIN.md Section H)
# Copy to .env for SAM local testing if needed. Never commit .env.

AI_SERVICE_URL=http://localhost:8001
MATCHING_SERVICE_URL=http://localhost:8002

DYNAMODB_ENDPOINT=http://localhost:4566
S3_ENDPOINT=http://localhost:4566

API_BASE_URL=http://localhost:3000
CEDAR_POLICY_PATH=./policies

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# If CEDAR_MODE=mock, the backend uses a pure-Python Cedar-compatible
# evaluator so the demo does not require a Cedar binary in PATH.
CEDAR_MODE=mock
