# Kalaa Setu — Unified environment template (matches BRAIN.md Section H)
# Copy to .env and adjust if needed. Never commit .env.

# LLM service (Ollama)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b-instruct

# Service URLs
AI_SERVICE_URL=http://localhost:8001
MATCHING_SERVICE_URL=http://localhost:8002
OPENSEARCH_URL=http://localhost:9200

# Service ports
AI_SERVICE_PORT=8001
MATCHING_SERVICE_PORT=8002

# LocalStack (DynamoDB + S3)
DYNAMODB_ENDPOINT=http://localhost:4566
S3_ENDPOINT=http://localhost:4566

# Backend API
API_BASE_URL=http://localhost:3000
CEDAR_POLICY_PATH=./policies

# AWS credentials (for LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Cedar mode (mock = Python evaluator, no Cedar binary required)
CEDAR_MODE=mock

# Client modes (auto = try HTTP, fall back to mock)
AI_CLIENT_MODE=auto
MATCHING_CLIENT_MODE=auto

# Voice (stretch features)
WHISPER_MODEL_PATH=
TTS_MODEL_PATH=
